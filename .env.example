# Neon pooled connection string (required for foundation)
# Use the pooled URL from the Neon dashboard, not the direct connection.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js (later phases)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Vercel Blob (later phases)
BLOB_READ_WRITE_TOKEN=

# Mapbox (later phases)
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_GEOCODING_TOKEN=
