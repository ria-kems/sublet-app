# Copy `.env.example` to `.env.local` and fill in:
# DATABASE_URL from Neon (pooled), AUTH_SECRET from openssl,
# BLOB_READ_WRITE_TOKEN from a Vercel Blob store,
# Mapbox public + geocoding tokens. See DEMO.md.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Optional. Leave unset locally so the current host/port is used.
# AUTH_URL=http://localhost:3000

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_GEOCODING_TOKEN=

# Shared password for seeded demo users (db:seed). Set in .env.local only.
DEMO_PASSWORD=
